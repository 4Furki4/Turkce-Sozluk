APP_IMAGE=furki4/turkish-dictionary-app:latest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-production-password
POSTGRES_DB=turkish_dictionary

AUTH_SECRET=change-this-production-auth-secret
AUTH_DISCORD_ID=change-this-discord-id
AUTH_DISCORD_SECRET=change-this-discord-secret
CRON_SECRET=change-this-production-cron-secret

DATABASE_URL=postgresql://postgres:change-this-production-password@pgbouncer-production:5432/turkish_dictionary?sslmode=disable
DATABASE_HOST=pgbouncer-production
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-this-production-password
DATABASE_DATABASE=turkish_dictionary

RECAPTCHA_SECRET_KEY=change-this-recaptcha-secret
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=change-this-recaptcha-site-key
BETTER_AUTH_URL=https://turkce-sozluk.com
NEXT_PUBLIC_APP_URL=https://turkce-sozluk.com
NEXT_PUBLIC_URL=https://turkce-sozluk.com
RESEND_API_KEY=re_xxxxxxxxx
RESEND_EMAIL_FROM="Türkçe Sözlük <no-reply@turkce-sozluk.com>"

UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=change-this-upstash-token

# Optional batch tools: offline data and pronunciation publication (not needed by Next.js runtime)
S3_API_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=change-this-r2-access-key
R2_SECRET_ACCESS_KEY=change-this-r2-secret-key
R2_BUCKET_NAME=your-media-bucket
NEXT_PUBLIC_R2_CUSTOM_URL=https://media.example.com

# Optional meaning-search service (legacy fallback retained when omitted)
# MEILI_HOST=http://meilisearch:7700
# MEILI_MASTER_KEY=replace-with-your-local-key
